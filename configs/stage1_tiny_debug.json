{
  "description": "Tiny CPU-oriented Stage 1 VAE recipe for smoke tests.",
  "data_files": [],
  "output_dir": "runs/stage1_tiny_debug",
  "max_steps": 2,
  "checkpoint_every": 1,
  "log_every": 1,
  "batch_size": 2,
  "seed": 0,
  "device": "cpu",
  "config": {
    "vae": {
      "tokenizer_name": "tiny",
