      "decoder_layers": 1,
      "hidden_size": 32,
      "ffn_size": 64,
      "num_attention_heads": 4,
      "attention_head_dim": 8
    },
    "optimizer": {
      "peak_lr": 0.0001,
      "warmup_steps": 2
    },
    "global_batch_size": 2,
    "tokens_per_step": 32,
    "kl_weight": 0.1,
    "mask_loss_weight": 0.2
  }
}
